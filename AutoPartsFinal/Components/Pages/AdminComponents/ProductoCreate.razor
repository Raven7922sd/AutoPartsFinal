@page "/Productos/Create"
@using Blazored.Toast.Services
@using AutoPartsFinal.Components.Models;
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject ProductoService ProductosService
@inject NavigationManager navigationmanager
@inject IToastService itoastservice
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@rendermode InteractiveServer

<PageTitle>Crear Producto</PageTitle>

<EditForm Model="productos" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container mt-4">
        <h3 class="fw-semibold text-center">Crear Nuevo Producto</h3>

        <div class="row mt-4">
            <div class="col-md-7">
                @* Columna izquierda para los campos del formulario *@
                <div class="card shadow-lg">
                    <div class="card-header position-relative text-center">
                        <h5 class="card-title">Detalles del Producto</h5>
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            <label class="form-label"><strong>Producto Id</strong></label>
                            @* El ID se generará automáticamente en la base de datos, aquí solo se muestra un valor predeterminado o se deja en blanco *@
                            <InputNumber class="form-control" @bind-Value="productos.ProductoId" readonly></InputNumber>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><strong>Nombre del Producto</strong></label>
                            <InputText class="form-control" @bind-Value="productos.ProductoNombre" placeholder="Ingrese el nombre"></InputText>
                            <ValidationMessage For="(() => productos.ProductoNombre)"></ValidationMessage>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><strong>Descripción del Producto</strong></label>
                            <InputTextArea class="form-control" @bind-Value="productos.ProductoDescripcion" placeholder="Ingrese la descripción"></InputTextArea>
                            <ValidationMessage For="(() => productos.ProductoDescripcion)"></ValidationMessage>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><strong>Monto (Precio)</strong></label>
                            <InputNumber class="form-control" step="0.01" @bind-Value="productos.ProductoMonto"></InputNumber>
                            <ValidationMessage For="(() => productos.ProductoMonto)"></ValidationMessage>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><strong>Cantidad (Stock)</strong></label>
                            <InputNumber class="form-control" @bind-Value="productos.ProductoCantidad"></InputNumber>
                            <ValidationMessage For="(() => productos.ProductoCantidad)"></ValidationMessage>
                        </div>
                    </div>

                    <div class="card-footer text-center">
                        <span class="btn-group" role="group">
                            <button type="reset" class="btn btn-outline-primary bi bi-arrow-clockwise" @onclick="Nuevo"> Limpiar</button>
                            <button type="submit" class="btn btn-outline-success bi bi-floppy"> Guardar</button>
                            <a href="/Productos/Index" class="btn btn-outline-secondary bi bi-box-arrow-left"> Volver</a>
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-md-5 d-flex justify-content-center align-items-start mt-3 mt-md-0">
                <div class="card shadow-sm p-4 text-center" style="height: 100%; min-height: 400px; width: 100%;">
                    <p class="text-muted mb-2">Imagen del Producto</p>
                    @if (!string.IsNullOrEmpty(productos.ProductoImagenUrl))
                    {
                        <img src="@productos.ProductoImagenUrl" class="img-fluid mb-3" alt="Imagen del producto" style="max-height: 250px; object-fit: contain; width: 100%;" />
                    }
                    else
                    {
                        <i class="bi bi-image fs-1 text-muted d-block mx-auto mb-3" style="font-size: 100px !important;"></i>
                    }
                    <p class="text-muted">Subir Imagen</p>
                    <InputFile OnChange="SubirImagen" accept=".jpg,.jpeg,.png,.gif" />
                    @* No hay ValidationMessage para ProductoImagenUrl aquí a menos que tengas una validación específica en tu modelo para ello *@
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private Productos productos { get; set; } = new Productos();
    private IBrowserFile? selectedImageFile; // Propiedad para el archivo seleccionado

    public void Nuevo()
    {
        this.productos = new Productos();
        this.selectedImageFile = null; // Limpiar el archivo seleccionado también
        Console.WriteLine("DEBUG: Formulario limpiado. selectedImageFile es null.");
    }

    // Método para manejar la selección del archivo de imagen
    private async Task SubirImagen(InputFileChangeEventArgs e)
    {
        Console.WriteLine("DEBUG: SubirImagen iniciado.");
        selectedImageFile = e.File;

        if (selectedImageFile != null)
        {
            Console.WriteLine($"DEBUG: Archivo seleccionado: {selectedImageFile.Name}, Tipo: {selectedImageFile.ContentType}, Tamaño: {selectedImageFile.Size} bytes.");

            // Opcional: Validar el tamaño del archivo
            if (selectedImageFile.Size > 5 * 1024 * 1024) // Limite de 5 MB
            {
                itoastservice.ShowError("La imagen no debe exceder los 5MB.");
                selectedImageFile = null; // Reiniciar para evitar que se intente subir
                productos.ProductoImagenUrl = null; // Limpiar previsualización
                Console.WriteLine("DEBUG: Imagen excede el tamaño. selectedImageFile es null.");
                return;
            }

            // Generar una URL temporal para previsualización (Data URL)
            // Esto es solo para que la imagen se vea en el navegador ANTES de guardar en el servidor.
            try
            {
                var buffer = new byte[selectedImageFile.Size];
                await selectedImageFile.OpenReadStream().ReadAsync(buffer);
                productos.ProductoImagenUrl = $"data:{selectedImageFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
                Console.WriteLine("DEBUG: Previsualización de imagen generada.");
            }
            catch (Exception ex)
            {
                itoastservice.ShowError($"Error al previsualizar la imagen: {ex.Message}");
                selectedImageFile = null;
                productos.ProductoImagenUrl = null; // Limpiar previsualización
                Console.WriteLine($"DEBUG: Error al previsualizar: {ex.Message}. selectedImageFile es null.");
            }
        }
        else
        {
            productos.ProductoImagenUrl = null; // Si no se selecciona archivo, limpiar previsualización
            Console.WriteLine("DEBUG: No se seleccionó ningún archivo. selectedImageFile es null.");
        }
    }

    public async Task Guardar()
    {
        Console.WriteLine("DEBUG: Guardar iniciado.");

        // Comprobación defensiva: Aunque productos se inicializa, es bueno tener una capa extra.
        if (productos == null)
        {
            itoastservice.ShowError("Error interno: El objeto producto es nulo.");
            Console.WriteLine("ERROR: El objeto 'productos' es nulo al intentar guardar.");
            return;
        }

        // 1. Manejar la subida de la imagen REAL al servidor si se ha seleccionado un archivo
        if (selectedImageFile != null)
        {
            Console.WriteLine($"DEBUG: selectedImageFile NO es null. Intentando subir imagen: {selectedImageFile.Name}");
            try
            {
                // Generar un nombre único para el archivo
                var uniqueFileName = $"{Guid.NewGuid()}_{selectedImageFile.Name}";
                Console.WriteLine($"DEBUG: Nombre único de archivo: {uniqueFileName}");

                // Construir la ruta completa donde se guardará la imagen en wwwroot/images/productos/
                // Asegúrate de que la carpeta wwwroot/images/productos exista en tu proyecto
                var folderPath = Path.Combine(WebHostEnvironment.WebRootPath, "images", "productos");
                Directory.CreateDirectory(folderPath); // Asegura que el directorio exista
                Console.WriteLine($"DEBUG: Ruta de la carpeta de imágenes: {folderPath}");

                var filePath = Path.Combine(folderPath, uniqueFileName);
                Console.WriteLine($"DEBUG: Ruta completa del archivo: {filePath}");

                // Guardar el archivo físicamente en el servidor
                using (var stream = File.Create(filePath))
                {
                    await selectedImageFile.OpenReadStream().CopyToAsync(stream);
                }

                // Asignar la URL relativa para que se guarde en la base de datos
                // y sea accesible desde el navegador
                productos.ProductoImagenUrl = $"/images/productos/{uniqueFileName}";
                itoastservice.ShowSuccess("Imagen subida con éxito.");
                Console.WriteLine($"DEBUG: Imagen guardada en servidor. URL asignada: {productos.ProductoImagenUrl}");
                selectedImageFile = null; // Limpiar el archivo seleccionado después de subirlo
            }
            catch (Exception ex)
            {
                itoastservice.ShowError($"Error al subir la imagen: {ex.Message}");
                Console.WriteLine($"ERROR: Fallo al subir la imagen: {ex.Message}");
                // Si la subida de la imagen falla, podrías decidir no guardar el producto
                // o guardar el producto sin imagen, dependiendo de tu lógica de negocio.
                // Aquí, he optado por detener el guardado del producto si la imagen falla.
                return;
            }
        }
        else
        {
            // Si no se seleccionó ninguna imagen nueva, asegúrate de que ProductoImagenUrl sea null
            // para un nuevo producto (o la lógica que desees si la imagen es opcional).
            // Si el campo ProductoImagenUrl es requerido en tu modelo, esto podría causar un error de validación.
            productos.ProductoImagenUrl = null;
            Console.WriteLine("DEBUG: No se seleccionó ninguna imagen nueva. ProductoImagenUrl establecido a null.");
        }


        // 2. Guardar el producto (con la nueva URL de la imagen o sin ella si no se subió ninguna)
        Console.WriteLine($"DEBUG: Intentando guardar producto. Nombre: {productos.ProductoNombre}, ImagenUrl: {productos.ProductoImagenUrl}");
        var guardo = await ProductosService.Guardar(this.productos); // Tu servicio de guardar

        if (guardo != null)
        {
            itoastservice.ShowSuccess("Producto guardado correctamente");
            navigationmanager.NavigateTo("/Productos/Index");
            Nuevo(); // Limpiar el formulario para un nuevo producto
            Console.WriteLine("DEBUG: Producto guardado y redirigido.");
        }
        else
        {
            itoastservice.ShowError("Error al almacenar el Producto");
            Console.WriteLine("ERROR: Fallo al guardar el producto a través del servicio.");
        }
    }
}
